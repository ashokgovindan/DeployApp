<Window x:Class="DeployApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Deployment Manager"
        Height="580" Width="1180"
        MinHeight="400" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Title -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>      <!-- Data Grid -->
            <RowDefinition Height="Auto"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Title + theme picker -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="📦  Change Requests &amp; EPALs"
                       Style="{StaticResource SectionHeader}" FontSize="18" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="BtnServiceNowSettings_Click"
                    Padding="12,5" Margin="0,0,16,0" ToolTip="Change the ServiceNow instance, username or password">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔧" Margin="0,0,6,0"/>
                    <TextBlock Text="ServiceNow Settings..."/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="2" Text="Theme" Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>

            <ComboBox x:Name="CmbTheme" Grid.Column="3" Width="140"
                      SelectionChanged="CmbTheme_SelectionChanged" ToolTip="Change the color theme">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding SwatchBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Click="BtnSubmitRequest_Click"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📤" Margin="0,0,6,0"/>
                    <TextBlock Text="Submit Deployment Request..."/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="BtnEdit_Click"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✏️" Margin="0,0,6,0"/>
                    <TextBlock Text="Edit"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="BtnRemoveSelected_Click"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑️" Margin="0,0,6,0"/>
                    <TextBlock Text="Remove Selected"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Click="BtnCreateCR_Click"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" Margin="0,0,6,0"/>
                    <TextBlock Text="Create CR"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Click="BtnCreateEPAL_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔐" Margin="0,0,6,0"/>
                    <TextBlock Text="Create EPAL"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Click="BtnRefresh_Click"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↻" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="7" Style="{StaticResource SecondaryButton}" Click="BtnClosedReport_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊" Margin="0,0,6,0"/>
                    <TextBlock Text="Closed Deployments Report..."/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Data Grid (styling comes from Themes/Controls.xaml) -->
        <DataGrid x:Name="DgDeployments" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single">

            <!-- Double-click opens Edit only on a data row, not on headers or scrollbars -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <EventSetter Event="MouseDoubleClick" Handler="DgRow_MouseDoubleClick"/>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- Checkbox column -->
                <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="0,8"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox Click="ChkSelectAll_Click" Loaded="ChkSelectAll_Loaded"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ToolTip="Select or clear all rows"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      Click="ChkRow_Click"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="RPA Name" Binding="{Binding RpaName}" Width="150"/>
                <DataGridTextColumn Header="Deployment" Binding="{Binding Deployment}" Width="150"/>
                <DataGridTextColumn Header="Change #" Binding="{Binding ChangeNumber}" Width="95"/>
                <DataGridTextColumn Header="RITM #" Binding="{Binding RitmNumber}" Width="95"/>
                <DataGridTextColumn Header="Environment" Binding="{Binding Environment}" Width="100"/>
                <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Requested" Binding="{Binding RequestDate}" Width="100"/>
                <DataGridTextColumn Header="Change Date" Binding="{Binding ChangeDate}" Width="105"/>
                <DataGridTextColumn Header="Deployed" Binding="{Binding DeployedDate}" Width="95"/>
                <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedBy}" Width="*" MinWidth="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource StatusBarBrush}" CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="10,6" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatusBar"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" FontSize="11"
                       Text="Loading..."/>
        </Border>
    </Grid>
</Window>

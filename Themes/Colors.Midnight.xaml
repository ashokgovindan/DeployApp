<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Midnight theme palette. Every theme defines the same keys. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#16213A"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A2641"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#1E2B48"/>
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E2E8F0"/>

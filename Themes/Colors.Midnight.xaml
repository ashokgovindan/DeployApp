    <SolidColorBrush x:Key="StatusBarBrush" Color="#16213A"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#94A3B8"/>
    <Color x:Key="ShadowColor">#99000000</Color>
</ResourceDictionary>

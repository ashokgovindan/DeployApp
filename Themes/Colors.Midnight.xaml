    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#173A55"/>

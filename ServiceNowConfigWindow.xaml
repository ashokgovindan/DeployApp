<Window x:Class="DeployApp.ServiceNowConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ServiceNow Configuration" Height="260" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="NoResize">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="🔧  ServiceNow Connection" Style="{StaticResource SectionHeader}" FontSize="16"/>

        <!-- Instance URL -->
        <TextBlock Grid.Row="2" Text="Instance URL" Style="{StaticResource FormLabel}"/>
        <TextBox x:Name="TxtInstanceUrl" Grid.Row="3" Style="{StaticResource FormTextBox}"
                 Tag="https://yourinstance.service-now.com"/>

        <TextBlock Grid.Row="4" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="You sign in to ServiceNow in the app's ServiceNow window. Your password is not stored here."/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SubmitButton}" Click="BtnSave_Click" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✔" Margin="0,0,6,0"/>
                    <TextBlock Text="Save"/>
                </StackPanel>
            </Button>
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

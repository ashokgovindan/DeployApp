<Window x:Class="DeployApp.ServiceNowBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ServiceNow" Height="260" Width="620"
        MinHeight="220" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status banner -->
        <Border Grid.Row="0" Background="{DynamicResource StatusBarBrush}"
                CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🤖" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Starting Chrome browser..."
                           Foreground="{DynamicResource StatusBarForegroundBrush}"
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ServiceNow URL display with Copy button -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,10"
                Background="{DynamicResource ControlBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔗" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtUrl" Grid.Column="1" IsReadOnly="True" BorderThickness="0"
                         FontSize="12" VerticalAlignment="Center"
                         Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                         Text="(loading...)" TextWrapping="NoWrap"
                         ToolTip="ServiceNow URL — select and copy, or click the Copy button"/>
                <Button x:Name="BtnCopyUrl" Grid.Column="2" Content="📋 Copy" Padding="10,4"
                        Margin="8,0,0,0" Click="BtnCopyUrl_Click"
                        ToolTip="Copy the ServiceNow URL to clipboard"
                        Style="{DynamicResource SecondaryButton}"/>
                <Button x:Name="BtnStartFilling" Grid.Column="3" Content="▶ Start Filling" 
                        Margin="8,0,0,0" Padding="10,4"
                        Click="BtnStartFilling_Click"
                        Style="{DynamicResource PrimaryButton}"
                        ToolTip="Click this if the app doesn't automatically detect the form."/>
            </Grid>
        </Border>

        <!-- Progress info -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtProgress" Text="Preparing..."
                       FontSize="14" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="Chrome is running in a separate window."
                       FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"/>
        </StackPanel>

        <!-- Close hint -->
        <TextBlock Grid.Row="3" Text="Do not close this window until all change requests are created."
                   FontSize="11" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
    </Grid>
</Window>

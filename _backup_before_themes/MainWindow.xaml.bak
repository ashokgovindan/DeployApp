<Window x:Class="DeployApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:DeployApp.Converters"
        mc:Ignorable="d"
        Title="Deployment Manager  -  PLS7282 - Ashok Govindan"
        Height="560" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PalestBlueBrush}"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </Window.Resources>

    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Title -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>      <!-- Data Grid -->
            <RowDefinition Height="Auto"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="📦  Change Requests &amp; EPALs"
                   Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,0,12"/>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Click="BtnSubmitRequest_Click"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📤" Margin="0,0,6,0"/>
                    <TextBlock Text="Submit Deployment Request..."/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="BtnEdit_Click"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✏️" Margin="0,0,6,0"/>
                    <TextBlock Text="Edit"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="BtnRemoveSelected_Click"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑️" Margin="0,0,6,0"/>
                    <TextBlock Text="Remove Selected"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Click="BtnCreateCR_Click"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" Margin="0,0,6,0"/>
                    <TextBlock Text="Create CR"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Click="BtnCreateEPAL_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔐" Margin="0,0,6,0"/>
                    <TextBlock Text="Create EPAL"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Click="BtnRefresh_Click"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↻" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="7" Style="{StaticResource SecondaryButton}" Click="BtnClosedReport_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊" Margin="0,0,6,0"/>
                    <TextBlock Text="Closed Deployments Report..."/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Data Grid -->
        <DataGrid x:Name="DgDeployments" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1"
                  RowHeaderWidth="0" Background="White"
                  HorizontalGridLinesBrush="#E8E8E8"
                  AlternatingRowBackground="#F8FAFD"
                  MouseDoubleClick="DgDeployments_MouseDoubleClick">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource HeaderBlueBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderGrayBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource LightBlueBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource LightBlueBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- Checkbox column -->
                <DataGridTemplateColumn Width="36">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="ChkSelectAll" Click="ChkSelectAll_Click"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="RPA Name" Binding="{Binding RpaName}" Width="150"/>
                <DataGridTextColumn Header="Deployment" Binding="{Binding Deployment}" Width="150"/>
                <DataGridTextColumn Header="Change #" Binding="{Binding ChangeNumber}" Width="90"/>
                <DataGridTextColumn Header="RITM #" Binding="{Binding RitmNumber}" Width="90"/>
                <DataGridTextColumn Header="Environment" Binding="{Binding Environment}" Width="90"/>
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                       FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Requested" Binding="{Binding RequestDate}" Width="100"/>
                <DataGridTextColumn Header="Change Date" Binding="{Binding ChangeDate}" Width="100"/>
                <DataGridTextColumn Header="Deployed" Binding="{Binding DeployedDate}" Width="90"/>
                <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedBy}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource LightBlueBrush}" CornerRadius="0"
                Padding="8,4" Margin="0,6,0,0" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1,0,1,1">
            <TextBlock x:Name="TxtStatusBar"
                       Foreground="{StaticResource PrimaryBlueBrush}" FontSize="11"
                       Text="0 open requests  -  0 without a RITM.  Closed requests are in the report. "/>
        </Border>
    </Grid>
</Window>

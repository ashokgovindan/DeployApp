<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Pre-theme backup copies. Not part of the build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);_backup_before_themes\**</DefaultItemExcludes>
    <ApplicationIcon>RPA_Icon.ico</ApplicationIcon>
    <StartupObject>DeployApp.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="RPA_Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="RPA_Icon2 copy.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Selenium.WebDriver" Version="4.50.0" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
